# Environment variables for AgriBrain Dashboard

# API Base URL (if you add a backend API in the future)
# VITE_API_URL=https://your-api-domain.com/api

# Application Environment
# VITE_APP_ENV=production

# Feature Flags
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_WEATHER_API=false

# Note: All environment variables must be prefixed with VITE_ 
# to be exposed to the client-side application
