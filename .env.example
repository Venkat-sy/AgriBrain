# ------------------------------------------------------------
# Example environment configuration for AgriSim
# ------------------------------------------------------------
# Backend configuration (used by both backend and frontend)
# ------------------------------------------------------------
# URL of the FastAPI backend when the frontend is deployed.
# For local development you can keep it empty and the frontend will use
# relative paths (Vite dev server proxy).
VITE_BACKEND_URL=https://YOUR_BACKEND_DOMAIN

# Backend service configuration (read by backend.core.config)
DATABASE_URL=sqlite:///./agrisim_dev.db
ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND_DOMAIN

# External API keys (optional – not required for core functionality)
IMD_API_KEY=YOUR_IMD_API_KEY
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Max upload size (bytes)
MAX_UPLOAD_SIZE=10485760
