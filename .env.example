# ------------------------------------------------------------
# Example environment configuration for AgriBrain
# ------------------------------------------------------------
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ------------------------------------------------------------

# =====================================================================
# CORE APPLICATION
# =====================================================================
APP_NAME=AgriBrain
APP_VERSION=3.0.0
DEBUG=false

# =====================================================================
# DATABASE (SQLite for dev, PostgreSQL for production)
# =====================================================================
# Development: sqlite:///./agrisim_dev.db
# Production: postgresql://user:pass@host:5432/dbname
# Render provides this automatically via fromDatabase
DATABASE_URL=sqlite:///./agrisim_dev.db

# =====================================================================
# CORS & NETWORK
# =====================================================================
# Comma-separated list of allowed origins for CORS
# Development: http://localhost:3000,http://localhost:5173
# Production: https://your-frontend.vercel.app,https://your-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================================================================
# JWT AUTHENTICATION (RS256 asymmetric keys)
# =====================================================================
# Path to RS256 private key for signing tokens (relative to backend/)
# Generate with: python scripts/generate_keys.py
JWT_PRIVATE_KEY_PATH=keys/private_key.pem
JWT_PUBLIC_KEY_PATH=keys/public_key.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=agribrain-api
JWT_AUDIENCE=agribrain-clients
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =====================================================================
# RATE LIMITING (7 tiers, requests per minute)
# =====================================================================
RATE_LIMIT_ENABLED=true
RL_AUTH_STRICT_RPM=10        # login, register, password reset
RL_API_STANDARD_RPM=60       # standard API endpoints
RL_API_BURST_RPM=120         # burst allowance for authenticated users
RL_ANONYMOUS_RPM=20          # unauthenticated requests
RL_ADMIN_RPM=300             # admin endpoints
RL_WEBSOCKET_RPM=50          # WebSocket connections
RL_WEBHOOK_RPM=100           # webhook endpoints

# =====================================================================
# SESSION MANAGEMENT
# =====================================================================
SESSION_TTL_MINUTES=30
SESSION_MAX_IDLE_MINUTES=15
SESSION_CLEANUP_CRON=0 */6 * * *  # every 6 hours

# =====================================================================
# ML MODEL PATHS (relative to backend/)
# =====================================================================
SOIL_CLASSIFIER_MODEL_PATH=models/soil_classifier.pkl
DISEASE_DETECTOR_MODEL_PATH=models/disease_detector.pkl
RAINFALL_FORECAST_MODEL_PATH=models/rainfall_forecast.pkl
YIELD_MODEL_PATH=models/yield_model.pkl
CROP_XGBOOST_MODEL_PATH=ml/saved_models/xgboost_crop_model.pkl

# =====================================================================
# EXTERNAL API KEYS (all optional - core functionality works without)
# =====================================================================
# Indian Meteorological Department API
IMD_API_KEY=

# OpenWeatherMap API (alternative weather provider)
OPENWEATHER_API_KEY=

# Open-Meteo doesn't require an API key (free tier)
# Weather API key for generic weather services
WEATHER_API_KEY=

# Groq API for LLM (Llama-3.3-70b, Llama-3.2-11b-vision)
GROQ_API_KEY=

# OpenRouter API (alternative LLM provider)
OPENROUTER_API_KEY=

# =====================================================================
# REDIS (Upstash) - for distributed rate limiting
# =====================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =====================================================================
# CROP DATABASE
# =====================================================================
CROPS_MASTER_YAML_PATH=data/crops_master.yaml
CROPS_MASTER_JSON_PATH=data/crops_master.json

# =====================================================================
# FILE UPLOAD
# =====================================================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# =====================================================================
# FRONTEND-SPECIFIC (Next.js - prefix with NEXT_PUBLIC_)
# =====================================================================
# Backend URL for frontend to call
# Development: http://localhost:8000
# Production: https://your-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# =====================================================================
# DEPLOYMENT PLATFORM SPECIFIC
# =====================================================================
# Render automatically provides these:
# - PORT (for backend)
# - DATABASE_URL (from linked PostgreSQL)
# 
# Vercel automatically provides these:
# - VERCEL_URL (for frontend)
# - NEXT_PUBLIC_VERCEL_URL
